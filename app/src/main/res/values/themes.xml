<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.PapraShare" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#1B1C21</item>
        <item name="colorPrimaryVariant">#18181A</item>
        <item name="colorOnPrimary">#F8F3EB</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#D9FF7A</item>
        <item name="colorSecondaryVariant">#909196</item>
        <item name="colorOnSecondary">#18181A</item>

        <!-- Background / surface -->
        <item name="android:colorBackground">#18181A</item>
        <item name="colorSurface">#1B1C21</item>
        <item name="colorOnSurface">#F8F3EB</item>

        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Text colors -->
        <item name="android:textColor">#F8F3EB</item>
        <item name="android:textColorPrimary">#F8F3EB</item>
        <item name="android:textColorSecondary">#F8F3EB</item>
        <item name="android:textColorHint">#909196</item>
        <item name="android:textColorLink">#D9FF7A</item>    </style>

    <style name="Theme.PapraShare.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.PapraShare.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.PapraShare.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
